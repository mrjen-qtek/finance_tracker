<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceTracker.ViewModels"
             xmlns:views="clr-namespace:FinanceTracker.Views"
             x:Class="FinanceTracker.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource Gray950}}">

    <Grid RowDefinitions="*,Auto">

        <!-- CONTENT AREA (Row 0) -->
        <Grid Grid.Row="0">
            <!-- 0: DASHBOARD TAB -->
            <Grid IsVisible="{Binding IsDashboardActive}">
                <views:DashboardView BindingContext="{Binding DashboardVm}" />
            </Grid>

            <!-- 1: TRANSACTIONS TAB -->
            <Grid IsVisible="{Binding IsTransactionsActive}">
                <views:TransactionsView BindingContext="{Binding TransactionsVm}" />
            </Grid>

            <!-- 2: ANALYTICS TAB -->
            <Grid IsVisible="{Binding IsAnalyticsActive}">
                <views:AnalyticsView BindingContext="{Binding AnalyticsVm}" />
            </Grid>
        </Grid>

        <!-- BLUE ROUNDED MOBILE BOTTOM NAVIGATION BAR (Row 1) -->
        <Border Grid.Row="1"
                Margin="18,4,18,14"
                HeightRequest="64"
                StrokeShape="RoundRectangle 28"
                StrokeThickness="0"
                Padding="6,4"
                Shadow="{Shadow Brush='#2563EB', Offset='0,6', Radius=16, Opacity=0.45}">
            
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2563EB" Offset="0.0" />
                    <GradientStop Color="#1D4ED8" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- 3 EQUAL COLUMNS: Dashboard, Transactions, Analytics (Add button removed) -->
            <Grid ColumnDefinitions="*,*,*" VerticalOptions="Center">

                <!-- 1. DASHBOARD -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        BackgroundColor="{Binding DashboardTabBg}"
                        Padding="12,6"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="0" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="📊" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Dashboard"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{Binding DashboardTabTextColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. TRANSACTIONS -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        BackgroundColor="{Binding TransactionsTabBg}"
                        Padding="12,6"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="1" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="💳" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Transactions"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{Binding TransactionsTabTextColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. ANALYTICS -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        BackgroundColor="{Binding AnalyticsTabBg}"
                        Padding="12,6"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="2" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="📈" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Analytics"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{Binding AnalyticsTabTextColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
